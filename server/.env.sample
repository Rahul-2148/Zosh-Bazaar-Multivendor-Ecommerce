# ==============================================================================
# ZOSH BAZAAR BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# Multi-Portal Web URLs (used for redirects, email links, and default origins)
CLIENT_URL=http://localhost:5173
LOGISTICS_URL=http://localhost:5174
SELLER_URL=http://localhost:5175
ADMIN_URL=http://localhost:5176
DELIVERY_PARTNER_URL=http://localhost:5177

# Allowed CORS & WebSocket Origins (comma-separated list for multi-domain deployment)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas cluster)
MONGODB_URI=mongodb://localhost:27017/zosh-bazaar

# JWT Authentication Secret Key (minimum 32 random characters recommended)
JWT_SECRET_KEY=your_super_secret_jwt_key_minimum_32_characters

# Email Notification Service (Nodemailer / SMTP Credentials)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Razorpay Payment Gateway Credentials (both aliases supported)
RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
RAZORPAY_TEST_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret