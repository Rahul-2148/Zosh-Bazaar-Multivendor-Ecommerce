# ==============================================================================
# ZOSH BAZAAR STOREFRONT CLIENT ENVIRONMENT TEMPLATE
# Copy this file to .env and configure your environment endpoints.
# ==============================================================================

# Backend API & Real-time Socket Server
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Multi-Vendor Connected Portals
VITE_SELLER_PORTAL_URL=http://localhost:5175
VITE_ADMIN_PORTAL_URL=http://localhost:5176
VITE_LOGISTICS_PORTAL_URL=http://localhost:5174

# Cloudinary Media Storage (Customer Reviews & Profile Photos)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_CLOUD_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_CLOUD_API_SECRET=your_cloudinary_api_secret
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset