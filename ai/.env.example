# ==============================================================================
# ZOSH BAZAAR AI/ML PLATFORM ENVIRONMENT TEMPLATE
# Copy this file to .env and configure your local settings.
# ==============================================================================

SERVICE_NAME=zosh-bazaar-ai
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/zosh-bazaar
REDIS_URL=redis://127.0.0.1:6379
AI_DATA_DIR=ai/data
MODEL_REGISTRY_PATH=ai/models/registry.json

# Internal Service Auth
INTERNAL_API_KEY=zb_ai_secret_internal_key_v1

# Security & CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5000","http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://localhost:5177"]

LOG_LEVEL=INFO
