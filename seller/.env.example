# ==============================================================================
# ZOSH BAZAAR SELLER CONSOLE ENVIRONMENT TEMPLATE
# Copy this file to .env and configure your environment endpoints.
# ==============================================================================

# Backend API & Real-time WebSocket Server
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Multi-Vendor Connected Portals
VITE_STOREFRONT_URL=http://localhost:5173
VITE_ADMIN_PORTAL_URL=http://localhost:5176

# Cloudinary Media Storage (Product Images & Catalogue Uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
